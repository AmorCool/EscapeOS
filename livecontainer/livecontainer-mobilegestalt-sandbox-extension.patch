+            static dispatch_once_t once;
+            dispatch_once(&once, ^{
+                void *h = dlopen("/usr/lib/system/libsystem_sandbox.dylib", RTLD_LAZY);
+                if (!h) h = dlopen("libsystem_sandbox.dylib", RTLD_LAZY);
